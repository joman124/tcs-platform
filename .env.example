# Copy to .env.local for local work, or set these in Vercel project settings. Never commit real values.

# Microsoft Entra app registration in the MHCA tenant (single tenant).
# Redirect URI to register: https://<your-domain>/api/auth/callback/microsoft-entra-id
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Random string, e.g. `openssl rand -base64 32`
AUTH_SECRET=

# Directory workbook in SharePoint (read-only). Graph drive id and item id of MHCA-Provider-Directory.xlsx.
DIRECTORY_DRIVE_ID=
DIRECTORY_ITEM_ID=

# Billing Fee Schedule (read-only; rates and cash prices are read live from it). Optional: the Billing copy is the default.
# FEE_SCHEDULE_DRIVE_ID=
# FEE_SCHEDULE_ITEM_ID=

# Patient benefits sheet (co-pay, deductible, co-insurance, out of pocket; one row per patient). Optional: without it the
# admin types the benefits in. Put the file on the estimator site; the drive defaults to DIRECTORY_DRIVE_ID and the tab
# to the first one. See docs/SETUP-CHECKLIST.md step 3d.
# BENEFITS_ITEM_ID=
# BENEFITS_DRIVE_ID=
# BENEFITS_SHEET=

# De-identified estimate log (SharePoint list). Leave blank to turn logging off.
LOG_SITE_ID=
LOG_LIST_ID=

# Log retention (deletes log rows older than 12 months). Off unless set to 1. Called by a Vercel Cron job, which sends
# CRON_SECRET as a bearer token. See docs/estimate-log-sharepoint.md.
# LOG_RETENTION_ENABLED=1
# CRON_SECRET=

# Demo mode: invented data, no sign-in. Local testing only. Ignored automatically when the settings above exist.
# DEMO_MODE=1
